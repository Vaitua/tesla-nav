# NAVIA fonctionne sans aucune variable ni clé (budget 0 €).
# Rien n'est lu depuis un fichier .env par l'application statique.
# Ce fichier documente seulement les réglages optionnels pour une future instance personnelle :
#
# VALHALLA_URL=https://votre-instance/route          # remplace VALHALLA dans app.js
# VALHALLA_BASE=https://votre-instance/              # remplace VALHALLA_BASE dans app.js
# NAVIA_CONFIG.base = https://raw.githubusercontent.com/<utilisateur>/<depot>/data/   # source des JSON de trafic (défaut : ce dépôt) ; essai local : ?tbase=/out/
# TOMTOM_KEY=                                        # secret du Worker worker/traffic-proxy.js (jamais dans le navigateur) ; non testé
# AI_PROXY_URL=https://votre-worker.workers.dev      # extension future : IA via backend (jamais de clé dans le navigateur)
# TESLA_FLEET_PROXY_URL=                             # extension future : API Fleet officielle via backend
